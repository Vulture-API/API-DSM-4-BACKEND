{
  "name": "api-dsm-4-backend",
  "version": "1.0.0",
  "description": "Backend monolítico modular do AgriTech",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vulture-API/API-DSM-4-BACKEND.git"
  },
  "keywords": [],
  "author": "Sette0o0",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Vulture-API/API-DSM-4-BACKEND/issues"
  },
  "homepage": "https://github.com/Vulture-API/API-DSM-4-BACKEND#readme",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.5.1",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^9.39.5",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^16.5.0",
    "prettier": "^3.9.8",
    "tsc-alias": "^1.9.5",
    "tsx": "^4.23.13",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/jwt": "^10.2.4",
    "@fastify/websocket": "^11.3.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.4",
    "fastify-type-provider-zod": "^7.0.0",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "private": true,
  "engines": {
    "node": "^24.0.0"
  }
}
