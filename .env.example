NODE_ENV=development
PORT=3000
# PostgreSQL externo; schema e migrations permanecem no API-DSM-4-BANCO.
DATABASE_URL=postgresql://usuario:senha@localhost:5432/agritech
# Ative após integrar login no frontend e configurar todos os perfis.
ACCESS_CONTROL_ENABLED=false
# Login e novas APIs de permissões exigem um segredo aleatório com ao menos 32 caracteres.
# JWT_SECRET=configure_um_segredo_aleatorio_fora_do_git
# Limites por IP, ativos também com controle de permissões desligado.
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000
STATION_OFFLINE_THRESHOLD_MINUTES=10
# Desligado no desenvolvimento para não consumir o checkpoint do banco compartilhado.
RULES_ENGINE_ENABLED=false
RULES_ENGINE_INTERVAL_MS=15000
RULES_ENGINE_BATCH_SIZE=500
CURRENT_READINGS_POLL_MS=3000
CURRENT_READINGS_MAX_CONNECTIONS=200
